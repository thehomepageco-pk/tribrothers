# Server
NODE_ENV=development
PORT=3001
SESSION_SECRET=change-this-to-a-long-random-string

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/software

# CORS (comma-separated origins; include Vite dev server when using npm run dev:client)
ALLOWED_ORIGIN=http://localhost:3001,http://localhost:5173

# Email (Gmail app password or SMTP)
MAIL_SERVICE=gmail
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# AI import (PDF → clients/suppliers). OpenAI-compatible API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
